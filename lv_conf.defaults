LV_USE_SDL 0
LV_USE_WAYLAND 0
LV_USE_X11 0
LV_USE_LINUX_DRM 0
LV_USE_LINUX_FBDEV 1
LV_USE_EVDEV 1

LV_USE_GLTF 0

LV_USE_DRAW_NANOVG 0
LV_USE_NANOVG 0
# SDL, DRM and Wayland need their EGL backend with the NanoVG renderer
LV_WAYLAND_USE_EGL 0
LV_SDL_AUTO_BACKEND 0
LV_SDL_BACKEND LV_SDL_BACKEND_SW
LV_LINUX_DRM_AUTO_BACKEND 0
LV_LINUX_DRM_BACKEND LV_LINUX_DRM_BACKEND_FBDEV

LV_USE_GSTREAMER 0
LV_USE_FREETYPE 1
LV_USE_LIBPNG 0
LV_USE_LIBJPEG_TURBO 0
LV_USE_FFMPEG 0


LV_USE_OPENGLES 0

LV_USE_3DTEXTURE 0

LV_USE_TINY_TTF 1
LV_TINY_TTF_FILE_SUPPORT 1

LV_BUILD_DEMOS 0
LV_BUILD_EXAMPLES 0

LV_USE_MATRIX 1
LV_USE_FLOAT 1
LV_USE_VECTOR_GRAPHIC 1
LV_USE_THORVG 1
LV_USE_THORVG_INTERNAL 1
LV_USE_LOTTIE 1

LV_USE_FS_STDIO         1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER      'A'

LV_DRAW_LAYER_SIMPLE_BUF_SIZE    (256 * 1024)
LV_OBJ_STYLE_CACHE      1
LV_USE_OBJ_NAME 1

# src/backends/drm.c indexes the lv_linux_drm_mode_t array, whose struct is private.
# Also makes LVGL's library dependencies (e.g. libdrm headers) visible to the app.
LV_USE_PRIVATE_API 1

LV_USE_DRAW_SW_COMPLEX_GRADIENTS 1
LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_FONT_MONTSERRAT_12	1
LV_FONT_MONTSERRAT_14	1
LV_FONT_MONTSERRAT_16	1
LV_FONT_MONTSERRAT_18	1
LV_FONT_MONTSERRAT_20	1
LV_FONT_MONTSERRAT_22	1
LV_FONT_MONTSERRAT_24	1
LV_FONT_MONTSERRAT_26	1
LV_FONT_MONTSERRAT_28	1
LV_FONT_MONTSERRAT_30	1
LV_FONT_MONTSERRAT_32	1
LV_FONT_MONTSERRAT_34	1
LV_FONT_MONTSERRAT_36	1
LV_FONT_MONTSERRAT_38	1
LV_FONT_MONTSERRAT_40	1
LV_FONT_MONTSERRAT_42	1
LV_FONT_MONTSERRAT_44	1
LV_FONT_MONTSERRAT_46	1
LV_FONT_MONTSERRAT_48	1
LV_FONT_MONTSERRAT_28_COMPRESSED	1
LV_FONT_DEJAVU_16_PERSIAN_HEBREW	1
LV_FONT_SOURCE_HAN_SANS_SC_16_CJK	1
LV_FONT_UNSCII_8	1
LV_FONT_FMT_TXT_LARGE       1

# Stdlib
LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB
